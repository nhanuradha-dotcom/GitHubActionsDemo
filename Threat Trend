
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.linear_model import LinearRegression

# Historical cybersecurity incident data
data = {
    "Month": [
        "Jan", "Feb", "Mar", "Apr",
        "May", "Jun", "Jul", "Aug",
        "Sep", "Oct", "Nov", "Dec"
    ],

    "Phishing": [
        30, 35, 38, 42, 48, 52,
        58, 62, 68, 75, 80, 88
    ],

    "Ransomware": [
        10, 12, 11, 15, 18, 20,
        22, 25, 27, 30, 34, 38
    ],

    "Malware": [
        25, 27, 26, 30, 32, 35,
        37, 40, 42, 45, 47, 50
    ]
}

df = pd.DataFrame(data)

print("HISTORICAL CYBER THREAT DATA")
print(df.to_string(index=False))

# Convert months into numerical values
X = np.arange(1, 13).reshape(-1, 1)

# Next three months
future_months = np.array([13, 14, 15]).reshape(-1, 1)

# Store predictions
predictions = {}

# Forecast each threat category
for threat in ["Phishing", "Ransomware", "Malware"]:

    y = df[threat].values

    # Train the Linear Regression model
    model = LinearRegression()
    model.fit(X, y)

    # Predict future incidents
    forecast = model.predict(future_months)

    # Convert predictions to whole numbers
    forecast = np.maximum(0, np.rint(forecast)).astype(int)

    predictions[threat] = forecast

    print("\nThreat:", threat)
    print("Predicted incidents:", forecast)

# Display future predictions
future_data = pd.DataFrame({
    "Month": ["Next Month", "Month + 2", "Month + 3"],
    "Phishing": predictions["Phishing"],
    "Ransomware": predictions["Ransomware"],
    "Malware": predictions["Malware"]
})

print("\nFUTURE THREAT FORECAST")
print(future_data.to_string(index=False))

# Plot historical and predicted trends
plt.figure(figsize=(11, 6))

for threat in ["Phishing", "Ransomware", "Malware"]:

    plt.plot(
        range(1, 13),
        df[threat],
        marker="o",
        label=threat + " Historical"
    )

    plt.plot(
        range(13, 16),
        predictions[threat],
        marker="s",
        linestyle="--",
        label=threat + " Forecast"
    )

plt.title("Cyber Threat Trend Forecasting")
plt.xlabel("Month Number")
plt.ylabel("Number of Incidents")

plt.xticks(range(1, 16))
plt.legend()
plt.grid(True)

plt.show()
