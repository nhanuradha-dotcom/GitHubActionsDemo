
import pandas as pd
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.pipeline import make_pipeline

# Training dataset
emails = [
    "Your account is suspended click here immediately",
    "Congratulations you won a lottery claim prize",
    "Verify your bank password immediately",
    "Meeting scheduled for tomorrow morning",
    "Please find the attached assignment",
    "Your college examination timetable is available",
    "Urgent update your password now",
    "Your payment receipt is attached"
]

labels = [
    "Phishing", "Phishing", "Phishing",
    "Legitimate", "Legitimate", "Legitimate",
    "Phishing", "Legitimate"
]

# Create ML model
model = make_pipeline(
    CountVectorizer(),
    MultinomialNB()
)

# Train model
model.fit(emails, labels)

# Test email
test_email = [
    "Urgent! Verify your bank account password now"
]

# Predict
prediction = model.predict(test_email)

print("Email:", test_email[0])
print("Prediction:", prediction[0])
