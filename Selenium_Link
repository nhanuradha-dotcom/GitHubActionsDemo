from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

driver = webdriver.Chrome()

driver.get("https://www.google.com")

driver.maximize_window()

wait = WebDriverWait(driver, 10)

# Search for a keyword
search_box = wait.until(
    EC.element_to_be_clickable((By.NAME, "q"))
)

search_box.send_keys("Python Selenium official documentation")
search_box.send_keys(Keys.ENTER)

# Wait for search results
wait.until(
    EC.presence_of_element_located((By.CSS_SELECTOR, "a h3"))
)

# Get first search result heading
first_heading = driver.find_element(
    By.CSS_SELECTOR, "a h3"
)

# Get complete link text
link_text = first_heading.text

print("First Search Result:", link_text)

# Locate hyperlink using LINK_TEXT
result_link = driver.find_element(
    By.LINK_TEXT, link_text
)

result_link.click()

print("Opened Page:", driver.title)

driver.quit()
