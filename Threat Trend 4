
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error

# Historical phishing incidents
months = np.arange(1, 13).reshape(-1, 1)

attacks = np.array([
    20, 25, 28, 30, 35, 40,
    42, 48, 52, 60, 65, 72
])

# Training data: first 9 months
X_train = months[:9]
y_train = attacks[:9]

# Testing data: last 3 months
X_test = months[9:]
y_test = attacks[9:]

# Train model
model = LinearRegression()
model.fit(X_train, y_train)

# Predict test data
predicted = model.predict(X_test)

# Calculate MAE
mae = mean_absolute_error(y_test, predicted)

print("Actual incidents:", y_test)
print("Predicted incidents:", np.round(predicted, 2))

print("Mean Absolute Error:", round(mae, 2))

# Train on all available data for future forecasting
model.fit(months, attacks)

future = np.array([13, 14, 15]).reshape(-1, 1)

forecast = model.predict(future)

print("\nFuture Threat Forecast:")

for month, value in zip([13, 14, 15], forecast):
    print("Month", month, ":", round(value))
