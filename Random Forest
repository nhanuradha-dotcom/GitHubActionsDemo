
import pandas as pd
from sklearn.ensemble import RandomForestClassifier

# Training data
data = {
    "packets": [20, 30, 25, 500, 600, 550, 40, 35],
    "bytes": [200, 300, 250, 8000, 9000, 8500, 400, 350],
    "duration": [10, 12, 8, 2, 1, 3, 15, 12],
    "label": [
        0, 0, 0, 1, 1, 1, 0, 0
    ]
}

df = pd.DataFrame(data)

X = df[["packets", "bytes", "duration"]]
y = df["label"]

# Train model
model = RandomForestClassifier(
    n_estimators=100,
    random_state=42
)

model.fit(X, y)

# Test network connection
test = pd.DataFrame(
    [[700, 10000, 1]],
    columns=["packets", "bytes", "duration"]
)

result = model.predict(test)

if result[0] == 1:
    print("ALERT: Suspicious network traffic")
else:
    print("Normal network traffic")
