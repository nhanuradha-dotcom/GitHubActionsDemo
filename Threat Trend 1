
import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression

data = {
    "Phishing": [20, 25, 30, 35, 40, 45],
    "Malware": [15, 18, 20, 23, 25, 28],
    "Ransomware": [5, 8, 10, 13, 17, 20],
    "SQL_Injection": [10, 12, 15, 17, 20, 24]
}

df = pd.DataFrame(data)

X = np.arange(1, 7).reshape(-1, 1)

future = np.array([[7], [8], [9]])

results = {}

for threat in df.columns:

    model = LinearRegression()

    model.fit(X, df[threat])

    forecast = model.predict(future)

    results[threat] = round(forecast[-1])

print("Threat Forecast for Month 9")

for threat, value in results.items():
    print(threat, ":", value)

highest = max(results, key=results.get)

print("\nHighest predicted threat:", highest)
